{
  "name": "@mia/onboarding-agent",
  "version": "0.1.0",
  "description": "Browser SDK for the self-hosted MIA onboarding agent.",
  "private": false,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "prepack": "npm run build",
    "test": "tsc -p tsconfig.json --noEmit"
  },
  "keywords": [
    "onboarding",
    "agent",
    "browser-sdk",
    "ai"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/Sricharan07/mia-onboarding-agent#readme",
  "bugs": {
    "url": "https://github.com/Sricharan07/mia-onboarding-agent/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sricharan07/mia-onboarding-agent.git",
    "directory": "sdk"
  },
  "dependencies": {
    "livekit-client": "^2.20.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
