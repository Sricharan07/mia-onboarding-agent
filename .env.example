# Docker Compose database. Generate the password with `openssl rand -hex 32`.
POSTGRES_USER=mia
POSTGRES_DB=mia
POSTGRES_PASSWORD=

# Public origins allowed to call Mia. Include the console/backend origin and every
# product origin that embeds the SDK. Production origins must use HTTPS.
CORS_ORIGIN=http://localhost:4000,http://localhost:3000
MIA_PORT=4000
TRUST_PROXY=false

# Generate these independently with `openssl rand -hex 32`.
# Keep the encryption key stable for the lifetime of the database.
MIA_SECRET_ENCRYPTION_KEY=
SETUP_TOKEN=

# Optional Gemini environment credential. When blank, enter it during console setup.
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
GEMINI_PLANNER_MODEL=gemini-3.5-flash
GEMINI_VISION_MODEL=gemini-3.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_EMBEDDING_DIMENSIONS=768
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
GEMINI_TOKEN_TTL_SECONDS=1800
GEMINI_NEW_SESSION_TTL_SECONDS=60

DATABASE_POOL_MAX=20
CONSOLE_SESSION_TTL_SECONDS=28800
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
RUNTIME_RATE_LIMIT_MAX=180
RUNTIME_TOKEN_TTL_SECONDS=900
RUNTIME_TOKEN_MAX_USES=2000
TRANSCRIPT_RETENTION_DAYS=30
DATA_RETENTION_SWEEP_INTERVAL_MS=3600000
MAX_UPLOAD_BYTES=52428800
PROVIDER_REQUEST_TIMEOUT_MS=90000
PROVIDER_RETRY_ATTEMPTS=3
SHUTDOWN_GRACE_PERIOD_MS=30000
UI_SCAN_ALLOW_PRIVATE_NETWORKS=false

# Local Node development only. Docker Compose creates its own service URL.
# DATABASE_URL=postgres://mia:YOUR_PASSWORD@127.0.0.1:5432/mia
# BACKEND_HOST=0.0.0.0
# BACKEND_PORT=4000
# LOCAL_UPLOAD_DIR=./data/uploads
# CONSOLE_DIST_DIR=./backend/console/dist
# UI_SCAN_HEADLESS=false
