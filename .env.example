NODE_ENV=development

BACKEND_HOST=0.0.0.0
BACKEND_PORT=4000
TRUST_PROXY=false
CORS_ORIGIN=*

DATABASE_URL=file:./data/sqlite/local.db
LOCAL_UPLOAD_DIR=./data/uploads
CONSOLE_DIST_DIR=./backend/console/dist

# Required to save per-app UI scan passwords encrypted at rest.
# Use a long random value and keep it stable for the lifetime of the database.
MIA_SECRET_ENCRYPTION_KEY=

# Required only to create the first console admin user. Use a long random value.
BOOTSTRAP_ADMIN_TOKEN=
CONSOLE_SESSION_TTL_SECONDS=28800
CONSOLE_AUTH_RATE_LIMIT_MAX=8

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
WORKFLOW_VIDEO_MAX_BYTES=52428800
GEMINI_LIVE_TOKEN_RATE_LIMIT_MAX=30

GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
GEMINI_TEXT_MODEL=gemini-2.5-flash
GEMINI_VISION_MODEL=gemini-2.5-flash
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
GEMINI_TOKEN_TTL_SECONDS=1800
GEMINI_NEW_SESSION_TTL_SECONDS=60

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
SEMANTIC_INDEX_DIR=./data/lancedb

# Backend-level fallback for UI mapping auth.
# Prefer per-app scan profiles in the console. Use a dedicated demo/test account only.
UI_SCAN_AUTH_MODE=none
UI_SCAN_LOGIN_URL=
UI_SCAN_USERNAME=
UI_SCAN_PASSWORD=
UI_SCAN_USERNAME_SELECTOR=
UI_SCAN_PASSWORD_SELECTOR=
UI_SCAN_SUBMIT_SELECTOR=
UI_SCAN_SUCCESS_URL_PATTERN=
UI_SCAN_POST_LOGIN_WAIT_MS=1000

# Keep false for local interactive mapping so the Playwright browser is visible.
UI_SCAN_HEADLESS=false

# Production default blocks private/reserved target networks during UI scans.
# Set true only when the backend is intentionally scanning private apps in a trusted network.
UI_SCAN_ALLOW_PRIVATE_NETWORKS=false
